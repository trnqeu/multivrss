# Copy to .env and fill in real values.
# See CLAUDE.md's "Environment Variables" section for more context on each var.

# --- Database (required) ---
# DB_USER/DB_PASSWORD/DB_NAME feed docker-compose's Postgres container;
# DATABASE_URL is what the app/Prisma actually reads — keep them in sync.
DB_USER=multivrss
DB_PASSWORD=change-me
DB_NAME=multivrss-db
DATABASE_URL=postgresql://multivrss:change-me@localhost:5435/multivrss-db?schema=public

# --- NextAuth (required) ---
NEXTAUTH_URL=http://localhost:3002
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- OAuth providers (required for GitHub/Google sign-in) ---
# GitHub: https://github.com/settings/developers -> New OAuth App
#   Callback URL: http://localhost:3002/api/auth/callback/github
GITHUB_ID=
GITHUB_SECRET=
# Google: https://console.cloud.google.com/apis/credentials -> OAuth client ID
#   Callback URL: http://localhost:3002/api/auth/callback/google
GOOGLE_ID=
GOOGLE_SECRET=

# --- Redis (required; rate limiter + BullMQ job queue) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Cron / internal endpoints (required) ---
# Any strong random string, e.g.: openssl rand -hex 32
CRON_SECRET=
INTERNAL_SECRET=

# --- Email (required for password reset / verification emails) ---
# Resend: https://resend.com/api-keys
RESEND_API_KEY=

# --- Optional ---
STAGING_PASSWORD=
EXTENSION_ORIGIN=
# YouTube Data API key, only needed for YouTube channels as feed sources:
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# --- Sentry (optional; error monitoring) ---
# https://sentry.io -> Project Settings -> Client Keys (DSN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed for source-map upload at build time (CI)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
