generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String     @id @default(cuid())
  username   String     @unique
  email      String     @unique
  password   String?
  emailVerified DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  categories Category[]
  accounts   Account[]
  sessions   Session[]
  passwordResetTokens PasswordResetToken[]
  savedLinks          SavedLink[]
  tags                Tag[]
  emailVerificationTokens EmailVerificationToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}


model Category {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources   FeedSource[]

  @@unique([userId, name])
}

model FeedSource {
  id         String     @id @default(cuid())
  url        String
  slug       String     @unique
  title      String?
  lastSync   DateTime?
  ttlMinutes Int?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  items      FeedItem[]

  @@unique([categoryId, url])
}

model FeedItem {
  id         String     @id @default(cuid())
  externalId String
  title      String
  link       String
  content    String?
  pubDate    DateTime?
  read       Boolean    @default(false)
  savedAt    DateTime?
  sourceId   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  source     FeedSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  tags       FeedItemTag[]

  @@unique([sourceId, externalId])
  @@index([sourceId])
  @@index([pubDate])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerificationToken {
  id      String   @id @default(cuid())
  userId  String
  token   String   @unique
  expires DateTime
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedLink {
  id          String   @id @default(cuid())
  userId      String
  url         String
  title       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags        SavedLinkTag[]

  @@index([userId])
}

model Tag {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  savedLinks SavedLinkTag[]
  feedItems  FeedItemTag[]

  @@unique([userId, name])
  @@index([userId])
}

model SavedLinkTag {
  savedLinkId String
  tagId       String

  savedLink SavedLink @relation(fields: [savedLinkId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([savedLinkId, tagId])
}

model FeedItemTag {
  feedItemId String
  tagId      String

  feedItem FeedItem @relation(fields: [feedItemId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([feedItemId, tagId])
}
