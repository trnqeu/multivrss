generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id        String       @id @default(cuid())
  name      String       @unique
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  sources   FeedSource[] @relation("CategoryToFeedSource")
}

model FeedSource {
  id         String     @id @default(cuid())
  url        String     @unique
  title      String?
  lastSync   DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  items      FeedItem[]
  categories Category[] @relation("CategoryToFeedSource")
}

model FeedItem {
  id         String     @id @default(cuid())
  externalId String     @unique
  title      String
  link       String
  content    String?
  pubDate    DateTime?
  read       Boolean    @default(false)
  sourceId   String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  source     FeedSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([pubDate])
}
